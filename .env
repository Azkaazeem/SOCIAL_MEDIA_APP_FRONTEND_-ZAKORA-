# ==============================================================
# ZAKORA SOCIAL MEDIA APP - FRONTEND ENVIRONMENT VARIABLES
# ==============================================================
# Copy these key-value pairs directly into Vercel Project Settings -> Environment Variables

# Backend API URL (Production Vercel backend URL)
VITE_API_URL=https://social-media-app-backend-azka-azeems-projects.vercel.app/api

# Public assets folder path
VITE_PUBLIC_FOLDER=/assets/

# WebSocket server URL (Optional - used if backend socket server is separate)
VITE_SOCKET_URL=https://social-media-app-backend-azka-azeems-projects.vercel.app
