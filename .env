# ==============================================================
# ZAKORA SOCIAL MEDIA APP - FRONTEND ENVIRONMENT VARIABLES
# ==============================================================
# Copy these key-value pairs directly into Vercel Project Settings -> Environment Variables

# Backend API URL (Production permanent backend URL)
VITE_API_URL=https://social-media-app-backend-tan.vercel.app/api

# Public assets folder path
VITE_PUBLIC_FOLDER=/assets/

# WebSocket server URL (Optional)
VITE_SOCKET_URL=https://social-media-app-backend-tan.vercel.app
